+/* Called as the job user, so the kernel decides who may lower niceness
+ * (root, RLIMIT_NICE), and after setsid(): with autogroups the new session
+ * competes for CPU as a whole, so it gets the job's niceness too.
+ */
+static void set_job_nice(int inc, int autogroup_fd, int crond_fd) {
+	char buf[16], eof;
+	int len, niceness;
+
+	errno = 0;
+	niceness = nice(inc);
+	if (niceness == -1 && errno != 0) {
+		snprintf(buf, sizeof buf, "%d", inc);
+		log_it("CRON", getpid(), "NICE FAILED", buf, errno);
+	}
+	else if (autogroup_fd >= 0) {
+		len = snprintf(buf, sizeof buf, "%d", niceness);
+		/* EAGAIN comes after the kernel's permission checks, only the rate
+		 * limit for writers without CAP_SYS_ADMIN refused it: crond retries,
+		 * and the job waits for that so it does not run at autogroup nice 0 */
+		if (write(autogroup_fd, buf, (size_t)len) < 0) {
+			if (errno == EAGAIN && crond_fd >= 0 &&
+				write(crond_fd, &niceness, sizeof niceness) == sizeof niceness) {
+				while (read(crond_fd, &eof, 1) < 0 && errno == EINTR) ;
+			}
+			else
+				log_it("CRON", getpid(), "AUTOGROUP NICE FAILED", buf, errno);
+		}
+	}
+	if (autogroup_fd >= 0)
+		close(autogroup_fd);
+}
+
+/* Runs in crond's process, still root, which the rate limit does not apply to.
+ * Reads EOF when the job closes its descriptors before exec; after a handed
+ * over write, closing the socket lets the job go on, whatever the result.
+ */
+static void finish_job_autogroup(pid_t jobpid, int nice_sock[2]) {
+	char path[64], buf[16];
+	int fd, len, niceness;
+	ssize_t n;
+
+	close(nice_sock[1]);
+	while ((n = read(nice_sock[0], &niceness, sizeof niceness)) < 0 &&
+		errno == EINTR) ;
+	if (n == sizeof niceness) {
+		snprintf(path, sizeof path, "/proc/%ld/autogroup", (long) jobpid);
+		len = snprintf(buf, sizeof buf, "%d", niceness);
+		if ((fd = open(path, O_WRONLY)) < 0 || write(fd, buf, (size_t)len) < 0)
+			log_it("CRON", getpid(), "AUTOGROUP NICE FAILED", buf, errno);
+		if (fd >= 0)
+			close(fd);
+	}
+	close(nice_sock[0]);	/* the job's acknowledgement: EOF */
+}
